# Copy to .env for local development. Never commit .env.
# Every variable here is validated by src/config/env.schema.ts at boot.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# The local MySQL from docker-compose.yml. Dev-only credentials: they open a
# database that listens on this machine and nowhere else.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=commerce_intelligence
DB_USER=app
DB_PASSWORD=app
DB_POOL_SIZE=10
# Leave unset locally: the local server has no certificate the app could verify.
# In AWS the task definition sets it to the RDS certificate bundle.
# DB_SSL_CA_PATH=/app/certs/eu-north-1-bundle.pem

# Local stand-ins so the app starts. Real installs run only on the deployed app
# (design §4.12), whose values come from the stage config and Secrets Manager.
SHOPIFY_CLIENT_ID=local-client-id
SHOPIFY_CALLBACK_URL=http://localhost:3000/installation/callback
SHOPIFY_CLIENT_SECRET=local-only-not-a-secret
COOKIE_SECRET=local-only-not-a-secret
